# Copy this file to .env and change the values for your installation.
# A variable set in the systemd unit overrides .env. .env overrides the default in config.py.
# Never put .env in the repository.

# Paths (default: the folder of the scripts)
# HW_BASE_DIR=/opt/homewizard
# HW_DB_PATH=/opt/homewizard/homewizard.db
# HW_UI_PATH=/opt/homewizard/ui.html

# HomeWizard P1 local API v1 and polling interval (seconds)
HW_METER_URL=http://192.168.1.50/api/v1/data
HW_POLL_INTERVAL_SEC=10
HW_METER_TIMEOUT_SEC=6

# Web and API server
HW_API_HOST=0.0.0.0
HW_API_PORT=8085
HW_HEALTH_MAX_AGE_SEC=120

# Optional: Signal messages through signal-cli-rest-api
HW_SIGNAL_URL=
HW_SIGNAL_FROM=
HW_SIGNAL_TO=
# Seconds to wait for the Signal server, and seconds in which the same message is not sent twice
HW_SIGNAL_TIMEOUT=4.0
HW_SIGNAL_COOLDOWN=30.0

# Alarm thresholds and times (default values)
HW_ALARM_IMBALANCE_DIFF_A=12.0
HW_ALARM_IMBALANCE_NEED=6
HW_ALARM_IMBALANCE_COOLDOWN=1200

HW_ALARM_PHASE_LIMIT_A=20.0
HW_ALARM_PHASE_NEED=3
HW_ALARM_PHASE_COOLDOWN=1800

HW_ALARM_SPIKE_LIMIT_A=22.0
HW_ALARM_SPIKE_NEED=3
HW_ALARM_SPIKE_COOLDOWN=1200

HW_ALARM_STALE_SEC=300
HW_ALARM_STALE_COOLDOWN=1200

HW_ALARM_VOLTAGE_LOW_V=215.0
HW_ALARM_VOLTAGE_HIGH_V=245.0
HW_ALARM_VOLTAGE_NEED=3
HW_ALARM_VOLTAGE_COOLDOWN=1800

# Power quality
HW_PQ_POWER_PEAK_W=9500.0
HW_PQ_DV_WARN_V=8.0
HW_PQ_CACHE_TTL_SEC=20.0
# The longest window the server allows, in hours (1 to 720). The "1 month" button needs 720.
HW_PQ_MAX_HOURS=720

# Electricity price and tariff (bidding zone SE1 to SE4)
HW_PRICE_AREA=SE3
HW_TARIFF_START_DATE=2026-11-01
HW_DEFAULT_FIXED_SEK=1.5
# Spot prices: seconds between two fetches, and the age (hours) at which a stored price is not used
HW_TARIFF_SYNC_COOLDOWN=300
HW_TARIFF_MAX_SLOT_AGE_HOURS=36
